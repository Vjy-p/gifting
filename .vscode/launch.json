  "version": "0.2.0",
  "configurations": [
    {
      "name": "gifting",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=keys.env",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8080"
      ]
    },
    {
      "name": "gifting (debug mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=keys.env",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8080"
      ]
    },
    {
      "name": "gifting (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=keys.env",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8080"
      ]
    },
    {
      "name": "gifting (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      // "deviceId": "chrome"
      "args": [
        "--dart-define-from-file=keys.env",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8080"
      ]
    }
  ]
}
